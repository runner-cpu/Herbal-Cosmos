{
  "name": "herbal-cosmos",
  "private": true,
  "type": "module",
  "scripts": {
    "build:catalog": "node scripts/build-herb-catalog.mjs",
    "build:food": "node scripts/build-food-medicine.mjs",
    "build:expanded": "node scripts/build-expanded-data.mjs",
    "build:data": "npm run build:catalog && npm run build:food && npm run build:expanded",
    "build:browser": "node scripts/build-browser-copies.mjs",
    "check:browser-copies": "node scripts/build-browser-copies.mjs --check",
    "restore:catalog-candidates": "node scripts/restore-legacy-candidates.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:expanded": "node scripts/validate-expanded-data.mjs",
    "validate:ethnic": "node scripts/validate-ethnic-data.mjs",
    "validate:data": "npm run validate:catalog && npm run validate:expanded && npm run validate:ethnic",
    "validate:app": "node scripts/validate-web-app.mjs",
    "check:inline": "node scripts/check-inline-runtime.mjs",
    "test:browser": "playwright test",
    "test:browser:ci": "playwright test --project=chromium --project=mobile",
    "test:browser:compat": "playwright test tests/browser/navigation.spec.js tests/browser/progressive-rendering.spec.js --project=firefox --project=webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
